# 本地环境变量：前端不需要 .env，误建的也不要提交
.env
.env.*
!.env.example
*.local

# 日志
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 编辑器：只共享扩展推荐，个人设置不入库
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.sw?

# 系统与本地 AI 助手配置
.DS_Store
/.claude/

